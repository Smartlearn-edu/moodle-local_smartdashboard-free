{{!
    @template local_smartdashboard/sections/grade_details
    Grade Details section for students.
}}
<div id="section-grade-details" class="dashboard-section d-none">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0 smart-text-adaptive">{{#str}} grade, local_smartdashboard {{/str}} Details</h4>
    </div>
    
    <div class="inline-grades-wrapper w-100">
        {{{inlinegrades}}}
    </div>
    
    <div class="card border-0 shadow-sm rounded-4 text-center mt-4 p-4">
        <form method="post" action="" style="display: inline-block;">
            <input type="hidden" name="userid" value="{{userid}}">
            <input type="hidden" name="action" value="export">
            <button type="submit" class="btn btn-primary btn-lg"><i class="fa fa-download me-2"></i>{{#str}} exporthtml, local_smartdashboard {{/str}}</button>
            <div style="margin-top: 8px; text-align: center;">
                <input type="checkbox" id="includedesc" name="includedesc" value="1">
                <label for="includedesc" class="form-check-label ms-1" style="cursor: pointer;">
                    {{#str}} includedescription, local_smartdashboard {{/str}}
                </label>
            </div>
        </form>
    </div>
</div>
