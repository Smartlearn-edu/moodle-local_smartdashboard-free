<!-- {{#str}}payment_analytics, local_smartdashboard{{/str}} Section -->
                {{#showpayment}}
                <div id="section-payments" class="dashboard-section d-none">
                    <div class="card shadow-sm border-0 mb-4 animate__animated animate__fadeIn">
                        <div class="card-body">
                            <h4 class="card-title mb-4"><i class="fa fa-money text-success me-2"></i> {{#str}}payment_analytics, local_smartdashboard{{/str}}</h4>
                            
                            <!-- Filters -->
                             <div class="row mb-4 g-2 align-items-end">
                                <!-- {{#str}}time_range, local_smartdashboard{{/str}} Preset -->
                                <div class="col-md-2">
                                    <label class="form-label small text-muted">{{#str}}time_range, local_smartdashboard{{/str}}</label>
                                    <select id="payment-filter-time" class="form-select">
                                        <option value="all">{{#str}}all_time, local_smartdashboard{{/str}}</option>
                                        <option value="today">{{#str}}today, local_smartdashboard{{/str}}</option>
                                        <option value="week">{{#str}}past_7_days, local_smartdashboard{{/str}}</option>
                                        <option value="month">{{#str}}past_30_days, local_smartdashboard{{/str}}</option>
                                        <option value="year">{{#str}}past_year, local_smartdashboard{{/str}}</option>
                                        <option value="custom">{{#str}}custom_range, local_smartdashboard{{/str}}</option>
                                    </select>
                                </div>
                                <!-- Custom Date Range (hidden by default) -->
                                <div class="col-md-2 d-none" id="payment-custom-dates-from">
                                    <label class="form-label small text-muted">{{#str}}from, local_smartdashboard{{/str}}</label>
                                    <input type="date" id="payment-date-from" class="form-control">
                                </div>
                                <div class="col-md-2 d-none" id="payment-custom-dates-to">
                                    <label class="form-label small text-muted">{{#str}}to, local_smartdashboard{{/str}}</label>
                                    <input type="date" id="payment-date-to" class="form-control">
                                </div>
                                <!-- {{#str}}category, local_smartdashboard{{/str}} Level 1 (Parent) -->
                                <div class="col-md-2">
                                     <label class="form-label small text-muted">{{#str}}category, local_smartdashboard{{/str}}</label>
                                     <select id="payment-filter-category" class="form-select">
                                         <option value="0">All Categories</option>
                                     </select>
                                </div>
                                <!-- {{#str}}category, local_smartdashboard{{/str}} Level 2 (Subcategory) -->
                                <div class="col-md-2 d-none" id="payment-subcat-wrapper">
                                     <label class="form-label small text-muted">Subcategory</label>
                                     <select id="payment-filter-subcategory" class="form-select">
                                         <option value="0">All</option>
                                     </select>
                                </div>
                                <!-- {{#str}}category, local_smartdashboard{{/str}} Level 3 (Sub-subcategory) -->
                                <div class="col-md-2 d-none" id="payment-subsubcat-wrapper">
                                     <label class="form-label small text-muted">Sub-subcategory</label>
                                     <select id="payment-filter-subsubcategory" class="form-select">
                                         <option value="0">All</option>
                                     </select>
                                </div>
                                <!-- Payment Gateway Filter -->
                                <div class="col-md-2">
                                     <label class="form-label small text-muted">Payment Gateway</label>
                                     <select id="payment-filter-gateway" class="form-select">
                                         <option value="">All Gateways</option>
                                     </select>
                                </div>
                                <!-- Filter Button -->
                                <div class="col-md-2 d-flex align-items-end">
                                    <button id="btn-refresh-payments" class="btn btn-primary w-100">
                                        <i class="fa fa-filter"></i> Filter
                                    </button>
                                </div>
                            </div>

                            <!-- Key Metrics Row -->
                             <div class="row mb-5">
                                <div class="col-md-6">
                                    <div class="p-4 border rounded bg-white text-dark text-center h-100 shadow-sm">
                                        <h6 class="text-uppercase small text-muted">{{#str}}to, local_smartdashboard{{/str}}tal Students Enrolled (Paid)</h6>
                                        <h2 id="payment-total-students" class="fw-bold mb-0 text-primary">-</h2>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-4 border rounded bg-white text-dark text-center h-100 shadow-sm">
                                        <h6 class="text-uppercase small text-muted">{{#str}}to, local_smartdashboard{{/str}}tal Revenue</h6>
                                        <h2 id="payment-total-revenue" class="fw-bold mb-0 text-success">-</h2>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Charts Row -->
                            <div class="row mb-5">
                                <div class="col-md-6">
                                    <h6 class="fw-bold text-center mb-3">Revenue per {{#str}}category, local_smartdashboard{{/str}}</h6>
                                    <div style="position: relative; height: 300px; width: 100%;">
                                        <canvas id="chart-payment-revenue"></canvas>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="fw-bold text-center mb-3">Compairson (Students vs Revenue)</h6>
                                    <div style="position: relative; height: 300px; width: 100%;">
                                        <canvas id="chart-payment-students"></canvas>
                                    </div>
                                </div>
                            </div>

                            <!-- {{#str}}category, local_smartdashboard{{/str}} Breakdown Table -->
                            <div class="mt-4 mb-5">
                                <h5 class="mb-3">{{#str}}category, local_smartdashboard{{/str}} Breakdown</h5>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>{{#str}}category, local_smartdashboard{{/str}} Name</th>
                                                <th class="text-center">No. of {{#str}}courses, local_smartdashboard{{/str}}</th>
                                                <th class="text-center">No. of Students</th>
                                                <th class="text-end">{{#str}}to, local_smartdashboard{{/str}}tal Revenue</th>
                                                <th class="text-end">% of {{#str}}to, local_smartdashboard{{/str}}tal</th>
                                            </tr>
                                        </thead>
                                        <tbody id="payment-category-table-body">
                                            <!-- Computed Rows -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- {{#str}}detailed, local_smartdashboard{{/str}} Table -->
                            <div class="mt-4">
                                <h5 class="mb-3">Course Breakdown</h5>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Course Name</th>
                                                <th>Short Name</th>
                                                <th class="text-center">Paid Enrollments</th>
                                                <th>Payment Breakdown</th>
                                                <th class="text-end">{{#str}}to, local_smartdashboard{{/str}}tal Revenue</th>
                                            </tr>
                                        </thead>
                                        <tbody id="payment-table-body">
                                            <!-- Computed Rows -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {{/showpayment}}

                 <!-- Settings Section -->
