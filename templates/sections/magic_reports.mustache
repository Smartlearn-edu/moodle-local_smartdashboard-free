<!-- {{#str}}magic_reports, local_smartdashboard{{/str}} Section -->
                {{#showmagic}}
                <div id="section-magic" class="dashboard-section d-none">
                    <div class="row mb-3">
                        <div class="col-12">
                            <h4 class="mb-3">{{#str}}magic_reports_title, local_smartdashboard{{/str}}</h4>
                            <p class="text-muted">{{#str}}magic_reports_desc, local_smartdashboard{{/str}}</p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <!-- {{#str}}saved_reports, local_smartdashboard{{/str}} Sidebar -->
                            <div class="card shadow-sm h-100">
                                <div class="card-header fw-bold">
                                    <i class="fa fa-folder-open me-2"></i> {{#str}}saved_reports, local_smartdashboard{{/str}}
                                </div>
                                <div class="list-group list-group-flush" id="saved-reports-list">
                                    <div class="text-center p-3 text-muted small">
                                        <i class="fa fa-spinner fa-spin"></i> {{#str}}loading, local_smartdashboard{{/str}}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-8">
                            <!-- Query Builder -->
                            <div class="card shadow-sm mb-4">
                                <div class="card-body">
                                    <label class="form-label fw-bold">{{#str}}ask_a_question, local_smartdashboard{{/str}}</label>
                                    <div class="input-group">
                                        <textarea id="magic-prompt" class="form-control" rows="2" placeholder="{{#str}}magic_prompt_placeholder, local_smartdashboard{{/str}}"></textarea>
                                        <button class="btn btn-primary" id="btn-magic-run">
                                            <i class="fa fa-magic me-2"></i> {{#str}}generate, local_smartdashboard{{/str}}
                                        </button>
                                    </div>
                                    <div class="form-text text-muted small mt-2">
                                        {{#str}}magic_ai_description, local_smartdashboard{{/str}}
                                    </div>
                                </div>
                            </div>

                            <!-- {{#str}}result, local_smartdashboard{{/str}}s Area -->
                            <div id="magic-results-area" style="display: none;">
                                <div class="card shadow-sm border-primary">
                                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-primary"><i class="fa fa-table me-2"></i> {{#str}}result, local_smartdashboard{{/str}}</span>
                                        <button class="btn btn-sm btn-outline-secondary" id="btn-save-report">
                                            <i class="fa fa-save"></i> {{#str}}save_report, local_smartdashboard{{/str}}
                                        </button>
                                    </div>
                                    <div class="card-body">
                                        <p id="magic-explanation" class="alert alert-info py-2 small mb-3"></p>
                                        
                                        <!-- Dynamic Chart -->
                                        <div id="magic-chart-container" class="mb-4" style="height: 300px; display: none;">
                                            <canvas id="magic-chart-canvas"></canvas>
                                        </div>

                                        <!-- Dynamic Table -->
                                        <div class="table-responsive">
                                            <table class="table table-hover table-sm" id="magic-table">
                                                <thead class="table-light"></thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                        
                                        <!-- SQL Debug (Optional/Admin) -->
                                        <div class="mt-3">
                                            <button class="btn btn-sm btn-link text-muted p-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSql">
                                                 {{#str}}show_generated_sql, local_smartdashboard{{/str}}
                                            </button>
                                            <div class="collapse mt-2" id="collapseSql">
                                                <pre class="bg-dark text-light p-3 rounded small mb-0" id="magic-sql-code"></pre>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {{/showmagic}}
