{{#hasannouncements}}
    
    <div class="modal fade" id="announcementsModal" tabindex="-1" aria-labelledby="announcementsModalLabel" aria-hidden="true" data-bs-backdrop="static" data-backdrop="static" data-bs-keyboard="false" data-keyboard="false">
      <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
          <div class="modal-header bg-primary text-white">
            <h5 class="modal-title" id="announcementsModalLabel"><i class="fa fa-bullhorn me-2"></i>{{#str}}latest_announcements, local_smartdashboard{{/str}}</h5>
            <button type="button" class="close btn-close btn-close-white text-white" data-bs-dismiss="modal" data-dismiss="modal" aria-label="{{#str}}close, local_smartdashboard{{/str}}">
                <span aria-hidden="true" class="d-none d-md-inline">&times;</span>
            </button>
          </div>
          <div class="modal-body p-4 bg-light">
            {{#announcements}}
            <div class="card mb-4 announcement-item border-0 shadow-sm" data-announcement-id="{{id}}">
                <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center pt-3 pb-0">
                    <span class="badge bg-info text-dark shadow-sm">{{coursename}}</span>
                    <small class="text-muted"><i class="fa fa-clock-o me-1"></i>{{formatteddate}}</small>
                </div>
                <div class="card-body">
                    <h5 class="card-title fw-bold text-primary mb-3">{{discussion_name}}</h5>
                    <div class="card-text text-dark" style="font-size: 0.95rem;">
                        {{{message}}}
                    </div>
                </div>
                <div class="card-footer bg-white border-top-0 d-flex justify-content-end pb-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm btn-dismiss-announcement" data-id="{{id}}">
                        <i class="fa fa-eye-slash me-1"></i> {{#str}}dont_show_again, local_smartdashboard{{/str}}
                    </button>
                </div>
            </div>
            {{/announcements}}
          </div>
          <div class="modal-footer bg-white border-top-0">
            <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal" data-dismiss="modal">{{#str}}close, local_smartdashboard{{/str}}</button>
          </div>
        </div>
      </div>
    </div>
    {{/hasannouncements}}
