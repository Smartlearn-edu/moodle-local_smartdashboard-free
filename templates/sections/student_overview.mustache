{{#js}}
require(['jquery'], function($) {
    var categories = {{#categories_json}}{{{categories_json}}}{{/categories_json}}{{^categories_json}}[]{{/categories_json}};
    
    function populateDropdown($select, parentId) {
        $select.html('<option value="all">All Subcategories</option>');
        var hasChildren = false;
        if (parentId !== 'all') {
            var children = categories.filter(function(c) { return c.parent == parentId; });
            if (children.length > 0) {
                children.forEach(function(c) {
                    $select.append('<option value="' + c.id + '">' + c.name + '</option>');
                });
                hasChildren = true;
            }
        }
        return hasChildren;
    }

    $('#sd-course-category').on('change', function() {
        var parentId = $(this).val();
        var $subcatContainer = $('#sd-subcategory-container');
        var $subsubcatContainer = $('#sd-subsubcategory-container');
        
        var hasChildren = populateDropdown($('#sd-course-subcategory'), parentId);
        if (hasChildren) {
            $subcatContainer.show();
        } else {
            $subcatContainer.hide();
        }
        
        // Hide and reset level 3
        $subsubcatContainer.hide();
        $('#sd-course-subsubcategory').val('all');
        $('#sd-course-subcategory').val('all');
        
        filterCourses();
    });

    $('#sd-course-subcategory').on('change', function() {
        var parentId = $(this).val();
        var $subsubcatContainer = $('#sd-subsubcategory-container');
        
        var hasChildren = populateDropdown($('#sd-course-subsubcategory'), parentId);
        if (hasChildren) {
            $subsubcatContainer.show();
        } else {
            $subsubcatContainer.hide();
        }
        
        $('#sd-course-subsubcategory').val('all');
        filterCourses();
    });

    function filterCourses() {
        var searchTerm = $('#sd-course-search').val().toLowerCase().trim();
        var catId = $('#sd-course-category').val();
        var subcatId = $('#sd-course-subcategory').val();
        var subsubcatId = $('#sd-course-subsubcategory').val();
        
        var teacherId = $('#sd-course-teacher').length ? $('#sd-course-teacher').val() : 'all';
        var programId = $('#sd-course-program').length ? $('#sd-course-program').val() : 'all';
        
        var activeCatId = (subsubcatId !== 'all' && subsubcatId) ? subsubcatId : ((subcatId !== 'all' && subcatId) ? subcatId : catId);
        var visibleCount = 0;

        $('.sc-catalog-col').each(function() {
            var $card = $(this);
            var title = ($card.data('title') || '').toString().toLowerCase();
            var path = $card.data('categorypath') || '';
            var teachers = ($card.data('teacherids') || '').toString().split(',');
            var programs = ($card.data('programids') || '').toString().split(',');

            var matchSearch = searchTerm === '' || title.indexOf(searchTerm) > -1;
            var matchCat = activeCatId === 'all' || path.indexOf('/' + activeCatId + '/') > -1;
            var matchTeacher = teacherId === 'all' || teachers.indexOf(teacherId) > -1;
            var matchProgram = programId === 'all' || programs.indexOf(programId) > -1;

            if (matchSearch && matchCat && matchTeacher && matchProgram) {
                $card.show();
                visibleCount++;
            } else {
                $card.hide();
            }
        });
        
        if (visibleCount === 0 && $('.sc-catalog-col').length > 0) {
            $('#sd-no-results-msg').show();
        } else {
            $('#sd-no-results-msg').hide();
        }
    }

    $('#sd-course-search').on('input', filterCourses);
    $('#sd-course-subsubcategory').on('change', filterCourses);
    if ($('#sd-course-teacher').length) {
        $('#sd-course-teacher').on('change', filterCourses);
    }
    if ($('#sd-course-program').length) {
        $('#sd-course-program').on('change', filterCourses);
    }
});
