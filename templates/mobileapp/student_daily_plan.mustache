{{=<% %>=}}
<%#hasdailyplan%>
<ion-list>
    <ion-list-header>
        <ion-label>{{ 'plugin.local_smartdashboard.todays_agenda' | translate }}</ion-label>
    </ion-list-header>

    <%#dailyplan.courses%>
    <ion-item-group>
        <ion-item-divider color="light">
            <ion-label><% coursename %></ion-label>
        </ion-item-divider>

        <%#overdue_items%>
        <ion-item>
            <ion-icon name="alert-circle-outline" slot="start" color="danger"></ion-icon>
            <ion-label class="ion-text-wrap">
                <h2><% title %></h2>
                <p color="danger"><% due_date_str %></p>
            </ion-label>
        </ion-item>
        <%/overdue_items%>

        <%#today_items%>
        <ion-item>
            <ion-icon name="calendar-outline" slot="start" color="primary"></ion-icon>
            <ion-label class="ion-text-wrap">
                <h2><% title %></h2>
                <p><% due_date_str %></p>
            </ion-label>
        </ion-item>
        <%/today_items%>
    </ion-item-group>
    <%/dailyplan.courses%>
</ion-list>
<%/hasdailyplan%>

<%^hasdailyplan%>
<ion-card>
    <ion-card-content class="ion-text-center ion-padding">
        <ion-icon name="checkmark-circle-outline" color="success" class="sd-mobile-big-icon"></ion-icon>
        <p>{{ 'plugin.local_smartdashboard.caught_up' | translate }}</p>
        <p class="sd-mobile-muted">{{ 'plugin.local_smartdashboard.no_pending_tasks' | translate }}</p>
    </ion-card-content>
</ion-card>
<%/hasdailyplan%>
