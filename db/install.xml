<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/smartdashboard/db" VERSION="20260215" COMMENT="XMLDB file for Moodle local_smartdashboard"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_smartdashboard_risk" COMMENT="At-risk student daily snapshots">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The student"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The course context"/>
        <FIELD NAME="riskscore" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Calculated risk 0-100"/>
        <FIELD NAME="risklevel" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="low" SEQUENCE="false" COMMENT="low, medium, or high"/>
        <FIELD NAME="score_login" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" SEQUENCE="false" COMMENT="Login recency sub-score"/>
        <FIELD NAME="score_completion" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" SEQUENCE="false" COMMENT="Completion sub-score"/>
        <FIELD NAME="score_grade" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" SEQUENCE="false" COMMENT="Grade sub-score"/>
        <FIELD NAME="score_overdue" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" SEQUENCE="false" COMMENT="Overdue activities sub-score"/>
        <FIELD NAME="score_adaptiveplan" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" SEQUENCE="false" COMMENT="Adaptive plan compliance sub-score"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="fk_courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_userid_courseid" UNIQUE="false" FIELDS="userid,courseid"/>
        <INDEX NAME="idx_risklevel" UNIQUE="false" FIELDS="risklevel"/>
        <INDEX NAME="idx_timecreated" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
